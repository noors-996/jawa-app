# اسم التطبيق اللي بيطلع فوق وعلى شاشة الموبايل
APP_NAME=مساعد جاوا

# كلمة سر الدخول للتطبيق (اختار وحدة قوية)
APP_PASSWORD=
# أي كلام عشوائي طويل
SECRET_KEY=

# مفتاح Claude من console.anthropic.com
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5

# مفتاح Composio من composio.dev (Settings > API Keys)
COMPOSIO_API_KEY=
# من Composio > Connected Accounts > حساب انستغرام jawapress الشغال (بيبلش بـ ca_)
COMPOSIO_CONNECTED_ACCOUNT_ID=
# (اختياري) الـ User ID اللي الحساب مربوط عليه بـ Composio
COMPOSIO_USER_ID=

IG_USER_ID=17841434449825074
IG_USERNAME=jawapress

# عنوان التطبيق على النت (https). انستغرام بياخد الصور والفيديوهات منه وقت النشر.
PUBLIC_BASE_URL=https://

TIMEZONE=Asia/Amman
# حط 1 عشان تجرب التطبيق بدون ما يلمس الحساب الحقيقي
DEMO_MODE=0
